              "counteroffer",
              "declined"
            ],
            "title": "Kind"
          },
          "amount": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 300000.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "months": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 120.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Months"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "StaffDecision"
      },
      "User": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "type": "string",
            "enum": [
              "client",
              "staff"
            ],
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "email",
          "name",
          "role"
        ],
        "title": "User"
      },
